VITE_API_BASE=https://api.ddbx.uk/api

# Discretion mode — gates the public site to drive iOS app installs.
# "on" (default): first drawer of the day shows full analysis, the rest blur
# behind an app CTA; the channel's Performance tab shows the proof (alpha,
# sectors, style) but teases the actual picks behind the app. "off": full
# unblurred UX. Flip per-browser at runtime with ?discretion=on|off|reset.
VITE_DISCRETION_MODE=off

# Apple Smart App Banner — trial of Safari's system install bar as an
# alternative to the floating mobile CTA, which is not converting.
#   off  — no banner (code default)
#   on   — banner AND the floating bar
#   solo — banner INSTEAD of the floating bar, on browsers that draw one
# Flip per-browser at runtime with ?banner=on|off|solo|reset.
VITE_SMART_BANNER=on
